datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Requisition {
  id          String   @id @default(uuid())
  reqId       String   @unique // e.g. REQ-2041
  department  String
  item        String
  amount      Float
  status      String   // e.g. "Pending Approval", "Approved", "Rejected"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contract {
  id        String   @id @default(uuid())
  conId     String   @unique // e.g. CON-8842-A
  initials  String
  supplier  String
  start     String
  end       String
  status    String   // e.g. "Active", "Expiring", "Terminated"
  createdAt DateTime @default(now())
}

model Order {
  id           String   @id @default(uuid())
  orderId      String   @unique // e.g. PO-1092
  supplier     String
  amount       Float
  deliveryDate String
  status       String   // e.g. "Draft", "Submitted", "Approved"
  description  String?
  items        Json     // List of items in the order
  createdAt    DateTime @default(now())
}

model GoodsReceipt {
  id           String   @id @default(uuid())
  receiptId    String   @unique // e.g. GRN-5521
  orderId      String
  supplier     String
  deliveryDate String
  status       String   // e.g. "Fully Received", "Partially Received"
  items        Json
  createdAt    DateTime @default(now())
}

model Invoice {
  id          String   @id @default(uuid())
  invoiceId   String   @unique // e.g. INV-3041
  supplier    String
  date        String
  amount      Float
  status      String   // e.g. "Paid", "Pending", "Overdue"
  items       Json
  createdAt   DateTime @default(now())
}

model Payment {
  id          String   @id @default(uuid())
  paymentId   String   @unique // e.g. PAY-9088
  invoiceId   String
  supplier    String
  amount      Float
  status      String   // e.g. "Processed", "Pending", "Failed"
  method      String
  auditTrail  Json
  createdAt   DateTime @default(now())
}

model RFQ {
  id          String   @id @default(uuid())
  rfqId       String   @unique // e.g. RFQ-2026-001
  title       String
  department  String
  deadline    String
  status      String   // e.g. "Draft", "Open", "Closed"
  vendorCount Int      @default(0)
  items       Json
  createdAt   DateTime @default(now())
}

model BudgetCategory {
  id        String   @id @default(uuid())
  category  String   @unique
  allocated Float
  spent     Float
  year      Int
  createdAt DateTime @default(now())
}

model Warehouse {
  id        String   @id @default(uuid())
  whId      String   @unique // e.g. WH-01
  name      String
  location  String
  capacity  Float    // in metric tons or sq ft
  fillLevel Float    // percentage filled (e.g. 75.0)
  status    String   // e.g. "Active", "Maintenance", "Full"
  createdAt DateTime @default(now())
}

model Shipment {
  id             String   @id @default(uuid())
  trackingNumber String   @unique // e.g. SH-7392-A
  origin         String
  destination    String
  carrier        String
  status         String   // e.g. "In Transit", "Delivered", "Delayed"
  estDelivery    String
  createdAt      DateTime @default(now())
}

model LogisticsRoute {
  id             String   @id @default(uuid())
  routeName      String   @unique // e.g. Chicago-NY Express
  costPerMile    Float
  avgTransitTime Float    // in hours
  volume         Float    // in tons/month
  createdAt      DateTime @default(now())
}

model Customer {
  id          String   @id @default(uuid())
  companyName String   @unique
  contact     String
  email       String
  status      String   // e.g. "Active", "Inactive"
  salesYTD    Float
  createdAt   DateTime @default(now())
}

model Carrier {
  id             String   @id @default(uuid())
  name           String   @unique
  type           String   // e.g. "Air Freight", "Truckload", "Sea Freight"
  rating         Float    // 0.0 to 5.0
  activeVehicles Int
  contact        String
  createdAt      DateTime @default(now())
}

