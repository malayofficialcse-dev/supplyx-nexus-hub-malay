{
  "name": "supplyx-backend",
  "version": "1.0.0",
  "description": "SupplyX Enterprise SCM API Backend",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node dist/server.js",
    "dev:watch": "nodemon --watch src --ext ts --exec \"npm run build && node dist/server.js\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "ioredis": "^5.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "nodemon": "^3.1.14",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
